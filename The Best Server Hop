-- DRAG-SYSTEM
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    StartButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    MenuFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y + 55)
end

StartButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = StartButton.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

StartButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- DER ULTIMATIVE ZAHLEN-INTERPRETER (Erkennt 20M, 20.5M, 20B etc. absolut fehlerfrei)
local function parseIncome(text)
    -- Bereinige den Text von störenden Zeichen, lasse aber Buchstaben für Multiplikatoren und Punkte da
    local cleanText = text:lower():gsub("%s+", ""):gsub("%$", ""):gsub("/s", ""):gsub(",", ".")
    
    -- Extrahiere nur die Zahl am Anfang (unterstützt jetzt auch Kommata/Punkte sauber)
    local numberPart = cleanText:match("^([%d%.]+)")
    if not numberPart then return 0 end
    
    local number = tonumber(numberPart)
    if not number then return 0 end
    
    -- Multiplikatoren extrem strikt prüfen
    if cleanText:find("m") then
        return number * 1000000
    elseif cleanText:find("k") then
        return number * 1000
    elseif cleanText:find("b") then -- Falls mal Milliarden-Pets kommen
        return number * 1000000000
    end
    
    return number
end

-- ENDLOS-SERVER-HOPPER (Sucht volle, aktive Lobbys und wiederholt bei Fehlern)
local function serverHop()
    local PlaceId = game.PlaceId
    local JobId = game.JobId
    local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100", tostring(PlaceId))
    
    TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
        if player == LocalPlayer then
            warn("[Hopper] Teleport fehlgeschlagen! Versuche es direkt noch mal...")
        end
    end)
    
    while true do
        StartButton.Text = "Suche Server..."
        StartButton.BackgroundColor3 = Color3.fromRGB(200, 100, 0) -- Orange
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            local guteServer = {}
            for _, server in ipairs(result.data) do
                if server.playing and server.maxPlayers and server.id ~= JobId then
                    -- Nur Lobbys, die voll/aktiv sind (Keine leeren Bot-Lobbys)
                    local mindestSpieler = math.floor(server.maxPlayers / 2)
                    if server.playing >= mindestSpieler and server.playing < (server.maxPlayers - 1) then
                        table.insert(guteServer, server)
                    end
                end
            end
            
            if #guteServer > 0 then
                local targetServer = guteServer[math.random(1, #guteServer)]
                StartButton.Text = "Hop in volle Lobby..."
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, targetServer.id, LocalPlayer)
                end)
                task.wait(4)
            else
                StartButton.Text = "Hop-Fallback..."
                for _, server in ipairs(result.data) do
                    if server.playing and server.maxPlayers and server.playing > 3 and server.id ~= JobId then
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                        end)
                        task.wait(4)
                        break
                    end
                end
            end
        end
        task.wait(1.5)
    end
end

-- HAUPTLOGIK
local running = true
local hopperThread = nil
local lastLogTime = 0

local function scanAndHopLogic()
    if hopperThread then task.cancel(hopperThread) end
    
    hopperThread = task.spawn(function()
        while running do
            local foundTargetPet = false
            local highestPetFound = 0
            
            -- Wir scannen jetzt JEDES TextLabel in der 3D-Welt
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("TextLabel") and v:IsDescendantOf(workspace) then
                    
                    -- Sicherheits-Check: Ignoriere deinen eigenen Namen oder deine ID im Text komplett
                    if not v.Text:find(LocalPlayer.Name) and not v.Text:find("197566") then
                        
                        -- Wandle den Text in eine echte, pure Zahl um
                        local petIncome = parseIncome(v.Text)
                        
                        -- Ignoriere absurde Shop-Dummys (über 1 Milliarde)
                        if petIncome > 0 and petIncome < 1000000000 then
                            if petIncome > highestPetFound then
                                highestPetFound = petIncome
                            end
                            
                            -- Wenn das gefundene Pet größer oder exakt gleich deinem Ziel ist (z.B. 20M >= 10M)
                            if petIncome >= currentThreshold then
                                foundTargetPet = true
                            end
                        end
                    end
                end
            end
            
            if tick() - lastLogTime > 3 then
                print(string.format("[Hopper] Höchstes gefundenes Haustier: %s | Ziel: %s", tostring(highestPetFound), tostring(currentThreshold)))
                lastLogTime = tick()
            end
            
            if foundTargetPet then
                StartButton.BackgroundColor3 = Color3.fromRGB(0, 180, 90) -- Grün
                if not MenuFrame.Visible then
                    local targetText = "10M"
                    if currentThreshold == THRESHOLDS.FIFTY_M then targetText = "50M" end
                    if currentThreshold == THRESHOLDS.HUNDRED_M then targetText = "100M" end
                    StartButton.Text = targetText .. " OK!"
                else
                    StartButton.Text = "Menü offen..."
                end
            else
                StartButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Rot
                
                for i = 5, 1, -1 do
                    if not running then return end
                    if not MenuFrame.Visible then
                        StartButton.Text = "Hop in " .. i .. "s..."
                    end
                    task.wait(1)
                end
                
                if running then
                    serverHop()
                    break
                end
            end
            task.wait(1)
        end
    end)
end

StartButton.MouseButton1Click:Connect(function()
    MenuFrame.Visible = not MenuFrame.Visible
    if MenuFrame.Visible then
        StartButton.Text = "Menü offen..."
    else
        StartButton.Text = "Scanne..."
    end
end)

scanAndHopLogic()
