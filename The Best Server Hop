-- Schwellenwerte
local THRESHOLDS = {
    TEN_M = 10000000,
    FIFTY_M = 50000000,
    HUNDRED_M = 100000000
}

local SETTINGS_FILE = "hopper_settings.json"
local currentThreshold = THRESHOLDS.TEN_M

-- Lade Einstellungen
local function loadSettings()
    if readfile then
        local success, content = pcall(readfile, SETTINGS_FILE)
        if success and content then
            local data = HttpService:JSONDecode(content)
            if data and data.threshold then
                currentThreshold = data.threshold
                print("[Hopper] Geladenes Ziel: " .. tostring(currentThreshold))
            end
        end
    end
end

-- Speichere Einstellungen
local function saveSettings(val)
    if writefile then
        currentThreshold = val
        local data = { threshold = val }
        pcall(writefile, SETTINGS_FILE, HttpService:JSONEncode(data))
    end
end

loadSettings()

