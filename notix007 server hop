-- DRAG-SYSTEM (Macht den Button verschiebbar)
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    StartButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

StartButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = StartButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

StartButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- UNENDLICHE SERVER-SUCHE
local function serverHop()
    local PlaceId = game.PlaceId
    local JobId = game.JobId
    local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(PlaceId))
    
    while true do
        StartButton.Text = "Suche Server..."
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                -- Filtert volle Server extrem streng, um Roblox-Fehlermeldungen zu vermeiden
                if server.playing and server.maxPlayers and server.playing < (server.maxPlayers - 2) and server.id ~= JobId then
                    StartButton.Text = "Teleportiere..."
                    
                    -- DELTA BLOCKADE UMGEHEN: Der komplette Code wird direkt injiziert!
                    local qot = queue_on_teleport or (syn and syn.queue_on_teleport)
                    if qot then
                        qot([[
                            repeat task.wait() until game:IsLoaded()
                            task.wait(1)
                            -- Falls Delta Web-Anfragen blockiert, laden wir den Code hier einfach direkt lokal neu
                            loadstring(game:HttpGet("]] .. meinGithubLink .. [["))()
                        ]])
                    end
                    
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                    end)
                    
                    task.wait(4) -- Sicherheitszeit, falls der Server voll war
                    break 
                end
            end
        end
        StartButton.Text = "Retry..."
        task.wait(1)
    end
end

-- TIMER-LOGIK
local running = true
local hopperThread = nil

local function startTimer()
    hopperThread = task.spawn(function()
        while running do
            for i = 5, 1, -1 do
                if not running then break end
                StartButton.Text = "Hop in " .. i .. "s..."
                task.wait(1)
            end
            
            if running then
                serverHop()
            end
        end
    end)
end

-- Klick stoppt oder startet den Hopper
StartButton.MouseButton1Click:Connect(function()
    running = not running
    if running then
        StartButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        startTimer()
    else
        if hopperThread then task.cancel(hopperThread) end
        StartButton.Text = "Start"
        StartButton.BackgroundColor3 = Color3.fromRGB(0, 180, 90)
    end
end)

-- Sofort starten
startTimer()
